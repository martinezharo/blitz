{
  "name": "blitz",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": "github:martinezharo/blitz",
  "description": "Learn the German and English words you pick.",
  "type": "module",
  "packageManager": "pnpm@12.10.0",
  "scripts": {
    "dev": "node scripts/migrate-local.ts && vite",
    "build": "pnpm check && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest run",
    "dictionary": "node scripts/build-dictionary.ts",
    "deploy": "pnpm build && wrangler d1 migrations apply blitz --remote && wrangler deploy",
    "curate": "node scripts/curate-dictionary.ts",
    "curated": "node scripts/apply-curated.ts",
    "list:new": "node scripts/new-list.ts"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.61.0",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@diffusionstudio/piper-wasm": "1.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
