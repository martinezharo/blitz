{
  "name": "blitz",
  "version": "0.1.0",
  "private": true,
  "description": "Learn the German and English words you pick.",
  "type": "module",
  "packageManager": "pnpm@12.10.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm check && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest run",
    "deploy": "pnpm build && wrangler d1 migrations apply blitz --remote && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
