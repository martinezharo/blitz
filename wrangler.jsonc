{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blitz",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Previews count their promo events apart, so tests there never reach the
  // production numbers.
  "previews": {
    "analytics_engine_datasets": [{ "binding": "PROMO_ANALYTICS", "dataset": "promo_events_preview" }]
  },
  // The app runs in the browser; the Worker answers /api: Google sign-in,
  // sync, definitions and voice downloads. Google credentials are secrets
  // (`wrangler secret put`, or .dev.vars locally).
  "assets": {
    "directory": "./dist",
    // The Worker reads the dictionary from here to know which meanings exist.
    "binding": "ASSETS",
    // Only / and /learn are pages, so an unknown path is a real 404
    // (public/404.html), not the app shell at an address that does not exist.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blitz",
      "database_id": "376b2c0d-5951-46ef-948a-b2094f2bb172",
      "migrations_dir": "migrations"
    }
  ],
  // Writes the definitions the dictionary lacks (worker/definition.ts). AI
  // bindings always run on Cloudflare, also in local development.
  "ai": { "binding": "AI", "remote": true },
  // The promo funnel (worker/promo.ts): visits from promos on the author's
  // other sites, in the dataset they write too.
  "analytics_engine_datasets": [{ "binding": "PROMO_ANALYTICS", "dataset": "promo_events" }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "blitz-photos" }],
  "observability": { "enabled": true }
}
